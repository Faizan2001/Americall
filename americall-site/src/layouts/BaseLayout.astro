---
import '@fontsource/chivo/400.css';
import '@fontsource/chivo/700.css';
import chivo700 from '@fontsource/chivo/files/chivo-latin-700-normal.woff2?url';
import '../styles/global.css';
import GlassPill from '../components/GlassPill.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = site.name, description = site.description } = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og/americall.png', site.url).href;

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: site.name,
	url: site.url,
	email: site.email,
	logo: new URL('/images/americall-hero-eagle.png', site.url).href,
	sameAs: [site.facebook],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#02122c" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Americall eagle logo with the text: Trained calling teams for U.S. service businesses" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" href={chivo700} as="font" type="font/woff2" crossorigin />
		<script type="application/ld+json" set:html={JSON.stringify(organization)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<GlassPill currentPath={path} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			// Below-the-fold sections ease in once, block by block. Nothing is hidden while waiting for JavaScript,
			// and the first screen is left alone so it never shifts after first paint.
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
			if (!reduced.matches && 'IntersectionObserver' in window) {
				const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
				const running = new Set<Animation>();
				const track = (animation: Animation) => {
					running.add(animation);
					animation.onfinish = animation.oncancel = () => running.delete(animation);
				};
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							observer.unobserve(entry.target);
							// Each block of the section follows the one before it by 60ms, capped so long sections still settle quickly.
							Array.from(entry.target.children).forEach((child, i) => {
								track(
									child.animate(
										[
											{ transform: 'translateY(14px)', opacity: 0.88 },
											{ transform: 'none', opacity: 1 },
										],
										{ duration: 650, delay: Math.min(i, 4) * 60, easing: ease, fill: 'backwards' },
									),
								);
							});
							// Photos settle from a slight zoom inside their clipped frames.
							entry.target.querySelectorAll('.media-frame img').forEach((img) => {
								track(img.animate([{ transform: 'scale(1.05)' }, { transform: 'none' }], { duration: 900, easing: ease }));
							});
						});
					},
					{ threshold: 0.06 },
				);
				const sections = document.querySelectorAll('main > section:not(:first-child) > .wrap');
				// Skip anything already on screen at load (short pages, anchor jumps, restored scroll).
				sections.forEach((el) => {
					if (el.getBoundingClientRect().top < window.innerHeight) return;
					observer.observe(el);
				});
				reduced.addEventListener('change', () => {
					if (!reduced.matches) return;
					observer.disconnect();
					running.forEach((animation) => animation.cancel());
				});
			}
		</script>
	</body>
</html>
