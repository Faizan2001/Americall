---
import '@fontsource/chivo/400.css';
import '@fontsource/chivo/700.css';
import '@fontsource/chivo/900.css';
import chivo900 from '@fontsource/chivo/files/chivo-latin-900-normal.woff2?url';
import '../styles/global.css';
import GlassPill from '../components/GlassPill.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = site.name, description = site.description } = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og/americall.png', site.url).href;

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: site.name,
	url: site.url,
	email: site.email,
	logo: new URL('/images/americall-hero-eagle.png', site.url).href,
	sameAs: [site.facebook],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#02122c" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Americall eagle logo with the text: Trained calling teams for U.S. service businesses" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" href={chivo900} as="font" type="font/woff2" crossorigin />
		<script type="application/ld+json" set:html={JSON.stringify(organization)} />
		<script is:inline>
			document.documentElement.classList.add('js-motion');
			/* If the bundled script never runs, show everything rather than leave content hidden. */
			setTimeout(function () {
				if (!window.__revealReady) document.documentElement.classList.remove('js-motion');
			}, 2500);
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<GlassPill currentPath={path} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			/* Entrances: heading, then text, then picture, once per element. */
			const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
			const show = (el: HTMLElement) => el.classList.add('is-in');

			if (!('IntersectionObserver' in window)) {
				items.forEach(show);
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								show(entry.target as HTMLElement);
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -5% 0px' },
				);
				items.forEach((el) => observer.observe(el));
			}
			(window as unknown as { __revealReady: boolean }).__revealReady = true;
		</script>
	</body>
</html>
