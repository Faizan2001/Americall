---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoCoupon from '../components/DemoCoupon.astro';
import { site } from '../data/site';

const [mailUser, mailDomain] = site.email.split('@');
---

<BaseLayout
	title="Contact Us"
	description="Request a free demo call with Americall to discuss appointment setting, campaign support and calling operations."
>
	<DemoCoupon headingLevel="h1" first />

	<section class="chapter ground-white mail" data-tone="light" aria-labelledby="mail-title">
		<div class="wrap">
			<h2 class="visually-hidden" id="mail-title">Email us</h2>
			<a class="mail__address t-head" href={`mailto:${site.email}`} data-reveal>
				{mailUser}@<wbr />{mailDomain}
			</a>
			<div class="mail__notes t-body" data-reveal style="--reveal-i:1">
				{site.showMailingAddress && <p>Mailing address only (no walk-in office): {site.mailingAddress}</p>}
				<p>
					<a class="text-link" href={site.facebook} rel="noopener">Americall on Facebook</a>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.mail {
		min-height: 60svh;
		display: flex;
		align-items: flex-end;
	}

	.mail .wrap {
		width: 100%;
	}

	.mail__address {
		display: block;
		color: inherit;
		text-decoration: none;
		text-transform: none;
		overflow-wrap: anywhere;
	}

	@media (hover: hover) and (pointer: fine) {
		.mail__address:hover {
			text-decoration: underline;
			text-decoration-thickness: 4px;
			text-underline-offset: 10px;
		}
	}

	.mail__notes {
		display: grid;
		gap: 8px;
		margin-top: 32px;
	}
</style>
