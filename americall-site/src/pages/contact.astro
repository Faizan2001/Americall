---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoCoupon from '../components/DemoCoupon.astro';
import { site } from '../data/site';

const [mailUser, mailDomain] = site.email.split('@');
---

<BaseLayout
	title="Contact Us"
	description="Request a free demo call with Americall to discuss appointment setting, campaign support and calling operations."
>
	<DemoCoupon headingLevel="h1" first />

	<section class="chapter ground-white mail" data-tone="light" aria-labelledby="mail-title">
		<div class="wrap mail__inner">
			<h2 class="visually-hidden" id="mail-title">Email us</h2>
			<a class="mail__address t-head" href={`mailto:${site.email}`}>
				{mailUser}@<wbr />{mailDomain}
			</a>
			<div class="mail__notes t-body">
				{site.showMailingAddress && <p>Mailing address only (no walk-in office): {site.mailingAddress}</p>}
				<p>
					<a class="text-link" href={site.facebook} rel="noopener">Americall on Facebook</a>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* A normal band, not a tall empty one: the email, then the other ways to reach Americall. */
	.mail__inner {
		display: grid;
		gap: 24px;
	}

	.mail__address {
		display: block;
		color: inherit;
		text-decoration: none;
		text-transform: none;
		overflow-wrap: anywhere;
	}

	@media (hover: hover) and (pointer: fine) {
		.mail__address:hover {
			text-decoration: underline;
			text-decoration-thickness: 4px;
			text-underline-offset: 10px;
		}
	}

	.mail__notes {
		display: grid;
		gap: 8px;
	}

	@media (min-width: 1024px) {
		.mail__inner {
			grid-template-columns: 1fr 1fr;
			align-items: end;
			gap: 64px;
		}
	}
</style>
