---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatementFields from '../components/StatementFields.astro';
import ProcessAccordion from '../components/ProcessAccordion.astro';
import IndustryLines from '../components/IndustryLines.astro';
import Packages from '../components/Packages.astro';
import NumbersBoard from '../components/NumbersBoard.astro';
import FaqBands from '../components/FaqBands.astro';
import DemoCoupon from '../components/DemoCoupon.astro';
import { homeFaqIndexes } from '../data/site';
---

<BaseLayout
	title="Trained Calling Teams For Qualified Appointments"
	description="Americall helps U.S. service businesses turn call operations into qualified appointments with trained agents, campaign management, and reliable support."
>
	<section class="chapter ground-navy hero" data-tone="dark" aria-labelledby="hero-title">
		<div class="wrap hero__inner">
			<h1 class="t-display hero__title" id="hero-title">
				Trained calling teams
			</h1>
			<div class="hero__side">
				<p class="t-lead">
					We set and confirm qualified appointments for U.S. solar, roofing, HVAC, real estate and home improvement companies.
				</p>
				<div class="hero__actions">
					<a class="btn btn-primary hero__cta" href="/contact/">Request a demo</a>
					<p class="t-small ink-2">We'll contact you to set up a short demo call.</p>
					<a class="link-arrow" href="#packages">See the packages <span class="arrow" aria-hidden="true">&rarr;</span></a>
				</div>
			</div>
		</div>
	</section>

	<StatementFields />
	<ProcessAccordion />
	<IndustryLines />
	<Packages />
	<NumbersBoard />
	<FaqBands indexes={homeFaqIndexes} showAllLink />
	<DemoCoupon />
</BaseLayout>

<style>
	.hero {
		min-height: max(560px, 100svh);
		display: flex;
		padding-top: var(--pill-clearance);
		padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
	}

	.hero__inner {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 40px;
	}

	.hero__title {
		margin-top: 6svh;
		max-width: 11ch;
	}

	.hero__side {
		display: grid;
		gap: 24px;
	}

	.hero__side .t-lead {
		max-width: 30ch;
	}

	.hero__actions {
		display: grid;
		gap: 10px;
		justify-items: start;
	}

	.hero__cta {
		width: 100%;
	}

	@media (min-width: 768px) {
		.hero__inner {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: auto 1fr auto;
			gap: var(--gap);
		}

		.hero__title {
			grid-column: 1 / span 10;
			margin-top: 4svh;
		}

		.hero {
			min-height: max(560px, 78svh);
		}

		.hero__side {
			grid-column: 7 / -1;
			grid-row: 3;
		}

		.hero__cta {
			width: auto;
		}
	}

	@media (min-width: 1280px) {
		.hero__side {
			grid-column: 9 / -1;
		}
	}
</style>
