---
import BaseLayout from '../layouts/BaseLayout.astro';
import Packages from '../components/Packages.astro';
import DemoCoupon from '../components/DemoCoupon.astro';
import { services, whyAmericallCards } from '../data/site';
import { photoCredits } from '../data/photos';
const servicePhoto = photoCredits.find((photo) => photo.slug === 'residential-solar')!;

/* Grounds alternate so no two light chapters touch: white, navy, white, navy. */
const grounds = ['white', 'navy', 'white', 'navy'];

/* Short display headings (full titles break the two-line headline rule). */
const shortTitles: Record<string, string> = {
	'dialer-crm': 'Dialers and CRMs',
	'agent-training': 'Recruiting and training',
	'campaign-management': 'Campaign management',
	'admin-support': 'Account support',
};
---

<BaseLayout
	title="Services"
	description="Dialer and CRM setup, agent recruitment and training, campaign management and dedicated account support from Americall."
>
	<section class="chapter ground-navy svc-hero" data-tone="dark" aria-labelledby="svc-title">
		<div class="wrap svc-hero__inner">
			<h1 class="t-display" id="svc-title">What we do</h1>
			<div class="svc-hero__side">
				<p class="t-lead">
					Four services, one team: agent recruitment and training, dialer and CRM setup, campaign management and account
					support.
				</p>
				<a class="btn btn-primary" href="/contact/">Request a demo</a>
			</div>
			<figure class="svc-photo">
				<div class="media-frame">
					<picture>
						{/* The large file only goes to wide screens, so phones never download it. */}
						<source
							media="(min-width: 1024px)"
							srcset={`${servicePhoto.file} 1200w, ${servicePhoto.file.replace('.webp', '-large.webp')} 1800w`}
							sizes="(min-width: 1440px) 1376px, 100vw"
						/>
						<img
							src={servicePhoto.file}
							srcset={`${servicePhoto.file.replace('.webp', '-small.webp')} 640w, ${servicePhoto.file} 1200w`}
							sizes="100vw"
							width="1200"
							height="674"
							alt={servicePhoto.alt}
							fetchpriority="high"
						/>
					</picture>
				</div>
				<figcaption class="t-small">
					Calling support for solar, roofing, HVAC, real estate and home improvement.
					<span>Industry photo by <a href={servicePhoto.source}>{servicePhoto.author}</a>.</span>
				</figcaption>
			</figure>
		</div>
	</section>

	{
		services.map((service, i) => (
			<section
				class:list={['chapter', `ground-${grounds[i]}`, 'svc', i % 2 === 1 && 'svc--mirror']}
				id={service.slug}
				data-tone={grounds[i] === 'navy' ? 'dark' : 'light'}
				aria-labelledby={`${service.slug}-title`}
			>
				<div class="wrap grid-12 svc__inner">
					<h2 class="t-head svc__title" id={`${service.slug}-title`} data-reveal>
						{shortTitles[service.slug] ?? service.title}
					</h2>
					<div class="svc__text" data-reveal style="--reveal-i:1">
						{service.description.split('\n\n').map((paragraph) => (
							<p class="t-body">{paragraph}</p>
						))}
					</div>
				</div>
			</section>
		))
	}

	<Packages />

	<section class="chapter ground-navy why" id="why-americall" data-tone="dark" aria-labelledby="why-title">
		<div class="wrap">
			<h2 class="t-head" id="why-title">Why Americall</h2>
			<ul class="why__list" role="list">
				{
					whyAmericallCards.map((card) => (
						<li class="why__row grid-12">
							<h3 class="t-lead why__q">{card.title}</h3>
							<p class="t-body why__a">{card.description}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<DemoCoupon />
</BaseLayout>

<style>
	.svc-photo {
		grid-column: 1 / -1;
		margin: 0;
	}

	.svc-photo img {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 7;
		object-fit: cover;
		object-position: 50% 55%;
	}

	.svc-photo figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		justify-content: space-between;
		margin-top: 12px;
	}

	.svc-photo figcaption span {
		color: var(--ink-2);
	}

	.svc-photo a {
		text-underline-offset: 3px;
	}

	@media (max-width: 767px) {
		.svc-photo img {
			aspect-ratio: 4 / 3;
		}
	}

	/* The hero photo settles once from first paint, so nothing moves after the page is shown. */
	@media (prefers-reduced-motion: no-preference) {
		.svc-photo img {
			animation: photo-settle 1100ms var(--ease-out) backwards;
		}
	}

	@keyframes photo-settle {
		from {
			transform: scale(1.04);
		}
	}

	.svc-hero {
		min-height: 0;
		display: flex;
		padding-top: var(--pill-clearance);
	}

	.svc-hero__inner {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 40px;
	}

	.svc-hero h1 {
		margin-top: 6svh;
	}

	.svc-hero__side {
		display: grid;
		gap: 24px;
		justify-items: start;
	}

	.svc-hero__side .t-lead {
		max-width: 32ch;
	}

	.svc__inner {
		row-gap: 28px;
	}

	.svc__title {
		grid-column: 1 / -1;
		align-self: start;
	}

	.svc__text {
		grid-column: 1 / -1;
		display: grid;
		gap: 16px;
		max-width: 60ch;
	}

	/* One lighter navy band with hairline rows, so it still reads apart from the navy demo section below. */
	.why {
		--ground: var(--color-navy-2);
		--rule: color-mix(in srgb, var(--color-ink-2-dark) 35%, transparent);
	}

	.why__list {
		margin: 40px 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule);
	}

	.why__row {
		row-gap: 10px;
		padding-block: 28px;
		border-bottom: 1px solid var(--rule);
	}

	.why__q {
		grid-column: 1 / -1;
		font-weight: 700;
	}

	.why__a {
		grid-column: 1 / -1;
		max-width: 62ch;
	}

	@media (min-width: 768px) {
		.svc-hero__inner {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: auto auto;
			gap: var(--gap);
		}

		.svc-hero h1 {
			grid-column: 1 / span 6;
		}

		.svc-hero__side {
			grid-column: 7 / -1;
			grid-row: 1;
			align-self: center;
			margin-top: 6svh;
		}

		.svc__title {
			grid-column: 1 / span 6;
		}

		.svc__text {
			grid-column: 7 / span 6;
		}

		.svc--mirror .svc__title {
			grid-column: 7 / span 6;
			grid-row: 1;
		}

		.svc--mirror .svc__text {
			grid-column: 1 / span 6;
			grid-row: 1;
		}

		.why__row {
			padding-block: 40px;
		}

		.why__q {
			grid-column: 1 / span 5;
		}

		.why__a {
			grid-column: 7 / span 6;
		}
	}
</style>
