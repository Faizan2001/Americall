---
import { navItems, site } from '../data/site';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => !href.includes('#') && currentPath === href;
---

<header class="pill" data-pill>
	<nav class="pill__bar" aria-label="Main">
		<a class="pill__brand" href="/" aria-label="Americall home">
			<img class="pill__logo" src="/images/americall-logo-nav.png" alt="Americall" width="262" height="96" />
		</a>
		<ul class="pill__links" role="list">
			{
				navItems.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<a class="btn btn-primary btn-small pill__cta" href="/contact/">
			<span class="pill__cta-long">Request a demo</span><span class="pill__cta-short">Demo</span>
		</a>
		<a class="pill__menu-link" href="#site-map" data-menu-fallback>Menu</a>
		<button class="pill__menu" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button hidden>
			<span class="visually-hidden" data-menu-label>Open menu</span>
			<span class="pill__menu-icon" aria-hidden="true"><span></span><span></span></span>
		</button>
	</nav>
	<div class="pill__sheet" id="site-menu" data-menu-sheet hidden>
		<ul role="list">
			{
				[{ label: 'Home', href: '/' }, ...navItems].map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-menu-close>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<a class="btn btn-primary pill__sheet-cta" href="/contact/" data-menu-close>Request a demo</a>
		<a class="pill__sheet-mail" href={`mailto:${site.email}`}>{site.email}</a>
	</div>
</header>
<div class="pill-scrim" data-menu-scrim hidden></div>

<style>
	.pill {
		position: fixed;
		z-index: 60;
		top: var(--pill-top);
		left: 50%;
		width: calc(100% - 32px);
		transform: translateX(-50%);
		border-radius: 28px;
		color: var(--color-navy);
		--focus: var(--color-navy);
		background-color: rgb(255 255 255 / 0.94);
		box-shadow: /* taste-skill-ignore: fixed floating bar, the one place a lift shadow is allowed */
			inset 0 0 0 1px rgb(2 18 44 / 0.08),
			inset 0 1px 0 rgb(255 255 255 / 0.9),
			0 10px 30px -14px rgb(2 18 44 / 0.35);
	}

	/* Frosted glass where supported; navy text on it stays at least 8:1 over every section colour. */
	@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.pill {
			background-color: rgb(255 255 255 / 0.72);
			-webkit-backdrop-filter: blur(14px) saturate(1.4);
			backdrop-filter: blur(14px) saturate(1.4);
		}
	}

	.pill.is-open {
		background-color: rgb(255 255 255 / 0.97);
	}

	.pill__bar {
		display: flex;
		align-items: center;
		gap: 10px;
		height: var(--pill-h);
		padding: 6px 6px 6px 12px;
	}

	.pill__brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		margin-right: auto;
		text-decoration: none;
		color: inherit;
		border-radius: var(--radius-pill);
	}

	.pill__logo {
		width: auto;
		height: 40px;
	}

	.pill__links {
		display: none;
		margin: 0;
		padding: 0;
		list-style: none;
		gap: 28px;
	}

	.pill__links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: var(--step-small);
		font-weight: 700;
		text-decoration: none;
		color: inherit;
		text-underline-offset: 6px;
		text-decoration-thickness: 2px;
	}

	.pill__links a[aria-current='page'] {
		text-decoration-line: underline;
	}

	@media (hover: hover) and (pointer: fine) {
		.pill__links a:hover {
			text-decoration-line: underline;
		}
	}

	.pill__cta-long {
		display: none;
	}

	.pill__menu-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 12px;
		font-size: var(--step-small);
		font-weight: 700;
		color: inherit;
	}

	.pill__menu {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		cursor: pointer;
		touch-action: manipulation;
	}

	.pill__menu[hidden] {
		display: none;
	}

	.pill__menu-icon {
		position: relative;
		display: block;
		width: 20px;
		height: 12px;
	}

	.pill__menu-icon span {
		position: absolute;
		left: 0;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 200ms var(--ease-out);
	}

	.pill__menu-icon span:first-child {
		top: 0;
	}

	.pill__menu-icon span:last-child {
		bottom: 0;
	}

	.pill__menu[aria-expanded='true'] .pill__menu-icon span:first-child {
		transform: translateY(5px) rotate(45deg);
	}

	.pill__menu[aria-expanded='true'] .pill__menu-icon span:last-child {
		transform: translateY(-5px) rotate(-45deg);
	}

	.pill__sheet {
		max-height: calc(100svh - var(--pill-top) - var(--pill-h) - 24px);
		overflow-y: auto;
		padding: 4px 14px 18px;
		transform-origin: top center;
		animation: sheet-in 200ms var(--ease-out);
	}

	.pill__sheet[hidden] {
		display: none;
	}

	.pill__sheet ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pill__sheet li a {
		display: flex;
		align-items: center;
		min-height: 56px;
		font-size: var(--step-lead);
		font-weight: 700;
		text-decoration: none;
		color: inherit;
	}

	.pill__sheet li a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 2px;
	}

	.pill__sheet-cta {
		width: 100%;
		margin-top: 12px;
	}

	.pill__sheet-mail {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		margin-top: 8px;
		font-size: var(--step-small);
		font-weight: 700;
		color: inherit;
	}

	@keyframes sheet-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.98);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		@keyframes sheet-in {
			from {
				opacity: 0;
			}
		}
	}

	.pill-scrim {
		position: fixed;
		inset: 0;
		z-index: 55;
		background: rgb(2 18 44 / 0.4);
	}

	.pill-scrim[hidden] {
		display: none;
	}

	@media (min-width: 768px) {
		.pill {
			width: min(880px, 100% - 48px);
			border-radius: var(--radius-pill);
		}

		.pill__bar {
			gap: 28px;
			padding: 8px 8px 8px 16px;
		}

		.pill__links {
			display: flex;
		}

		.pill__cta-long {
			display: inline;
		}

		.pill__cta-short,
		.pill__menu,
		.pill__menu-link,
		.pill__sheet,
		.pill-scrim {
			display: none !important;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.pill {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			background-color: var(--color-white);
		}
	}

	@media (forced-colors: active) {
		.pill {
			border: 1px solid CanvasText; /* taste-skill-ignore: forced-colors needs a visible edge */
		}
	}
</style>

<script>
	const pill = document.querySelector<HTMLElement>('[data-pill]');
	const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
	const fallback = document.querySelector<HTMLElement>('[data-menu-fallback]');
	const sheet = document.querySelector<HTMLElement>('[data-menu-sheet]');
	const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');
	const label = document.querySelector<HTMLElement>('[data-menu-label]');

	if (pill && button && sheet && scrim && fallback) {
		fallback.hidden = true;
		fallback.style.display = 'none';
		button.hidden = false;
		const outside = () => Array.from(document.querySelectorAll<HTMLElement>('main, footer'));

		const close = (returnFocus = true) => {
			if (button.getAttribute('aria-expanded') !== 'true') return;
			button.setAttribute('aria-expanded', 'false');
			if (label) label.textContent = 'Open menu';
			sheet.hidden = true;
			scrim.hidden = true;
			pill.classList.remove('is-open');
			document.documentElement.style.overflow = '';
			outside().forEach((el) => el.removeAttribute('inert'));
			if (returnFocus) button.focus();
		};

		const open = () => {
			button.setAttribute('aria-expanded', 'true');
			if (label) label.textContent = 'Close menu';
			sheet.hidden = false;
			scrim.hidden = false;
			pill.classList.add('is-open');
			document.documentElement.style.overflow = 'hidden';
			outside().forEach((el) => el.setAttribute('inert', ''));
			sheet.querySelector<HTMLElement>('a')?.focus();
		};

		button.addEventListener('click', () => (button.getAttribute('aria-expanded') === 'true' ? close() : open()));
		scrim.addEventListener('click', () => close());
		sheet.querySelectorAll('[data-menu-close]').forEach((link) => link.addEventListener('click', () => close(false)));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') close();
			if (event.key === 'Tab' && button.getAttribute('aria-expanded') === 'true') {
				const focusables = [button, ...Array.from(sheet.querySelectorAll<HTMLElement>('a'))];
				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				if (event.shiftKey && document.activeElement === first) {
					event.preventDefault();
					last.focus();
				} else if (!event.shiftKey && document.activeElement === last) {
					event.preventDefault();
					first.focus();
				}
			}
		});
		window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
			if (event.matches) close(false);
		});
	}
</script>
