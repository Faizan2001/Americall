---
import { industries } from '../data/site';
import { photoCredits } from '../data/photos';
---
<section class="chapter ground-navy industries" id="industries" aria-labelledby="industries-title">
 <div class="wrap">
  <div class="industry-intro">
   <h2 class="t-head" id="industries-title">Calling support for your industry</h2>
   <p class="t-body">Your team handles the sale. We handle the calls, qualification and appointment confirmations that come before it.</p>
  </div>
  <div class="industry-photos">
   {photoCredits.filter((photo) => photo.slug !== 'residential-solar').map((photo) => (
    <figure>
     <div class="media-frame"><img src={photo.file} srcset={`${photo.file.replace('.webp', '-small.webp')} 640w, ${photo.file} 1200w`} sizes="(min-width: 768px) 48vw, 100vw" alt={photo.alt} width="1200" height="800" loading="lazy" decoding="async" /></div>
     <figcaption class="t-small">{photo.caption} <span>Photo by <a href={photo.source}>{photo.author}</a></span></figcaption>
    </figure>
   ))}
  </div>
  <ul class="industry-links" role="list">
   {industries.map((industry) => (
    <li><a href={`/contact/?industry=${industry.slug}`}>{industry.name}</a></li>
   ))}
  </ul>
  <p class="t-small industry-note">Industry photography illustrates the businesses we support.</p>
 </div>
</section>
<style>
 .industry-intro { display: grid; gap: 24px; margin-bottom: 36px; }
 .industry-intro h2 { max-width: 18ch; }
 .industry-intro p { max-width: 46ch; align-self: end; }
 .industry-photos { display: grid; gap: 28px; }
 figure { margin: 0; min-width: 0; }
 .industry-photos img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 8px; }
 figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-top: 12px; }
 figcaption span { color: var(--ink-2); }
 figcaption a { text-underline-offset: 3px; }
 .industry-links { display: grid; margin: 32px 0 0; padding: 0; list-style: none; }
 .industry-links a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--ink-2); min-height: 64px; font-weight: 700; text-decoration: none; }
 .industry-links a:hover { text-decoration: underline; text-underline-offset: 5px; }
 .industry-note { margin-top: 24px; color: var(--ink-2); }
 @media (min-width: 768px) {
  .industry-intro { grid-template-columns: 1.2fr 1fr; gap: 64px; }
  .industry-photos { grid-template-columns: 1fr 1fr; gap: 32px; }
  .industry-links { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 32px; }
 }
</style>
