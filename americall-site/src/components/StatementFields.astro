---
import { statements } from '../data/site';
---
<section class="chapter ground-white services-overview" aria-labelledby="services-overview-title">
	<div class="wrap">
		<div class="overview-intro">
			<h2 class="t-head" id="services-overview-title">Support behind every campaign</h2>
			<a class="text-link" href="/services/">All services</a>
		</div>
		<div class="service-rows">
			{statements.map((item) => (
				<article class="service-row">
					<h3 class="t-lead">{item.phrase}</h3>
					<p class="t-body">{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>
<style>
	.overview-intro { display: grid; gap: 20px; margin-bottom: 40px; }
	.overview-intro h2 { max-width: 18ch; }
	.overview-intro a { justify-self: start; }
	.service-row { display: grid; gap: 12px; border-top: 1px solid var(--color-navy); padding-block: 28px; }
	.service-row h3 { font-weight: 700; }
	.service-row p { max-width: 62ch; }
	@media (min-width: 768px) {
		.overview-intro { grid-template-columns: 1fr auto; align-items: end; }
		.service-row { grid-template-columns: 1fr 1.5fr; gap: 64px; padding-block: 32px; }
	}
</style>
