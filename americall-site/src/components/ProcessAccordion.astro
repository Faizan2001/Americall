---
import { processStages } from '../data/site';

---

<section class="chapter ground-white process" id="how-it-works" data-tone="light" aria-labelledby="process-title">
	<div class="wrap">
		<div class="grid-12 process__intro">
			<h2 class="t-head process__title" id="process-title" data-reveal>How it runs</h2>
			<p class="t-body process__lede" data-reveal style="--reveal-i:1">
				Five stages, the same for every client. Your account manager walks you through each one.
			</p>
		</div>

		<ul class="stages" role="list" data-stages data-reveal style="--reveal-i:2">
			{
				processStages.map((stage, i) => (
					<li class:list={['stage', i % 2 === 1 && 'stage--alt']} data-open={i === 0 ? 'true' : 'false'}>
						<h3 class="stage__heading">
							<button
								class="stage__button"
								type="button"
								aria-expanded={i === 0 ? 'true' : 'false'}
								aria-controls={`stage-panel-${i}`}
								id={`stage-button-${i}`}
							>
								<span class="stage__name">{stage.name}</span>
							</button>
						</h3>
						<div class="stage__panel" id={`stage-panel-${i}`} role="region" aria-labelledby={`stage-button-${i}`}>
							<p class="t-body">{stage.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.process__intro {
		row-gap: 20px;
	}

	.process__title {
		grid-column: 1 / -1;
	}

	.process__lede {
		grid-column: 1 / -1;
		max-width: 46ch;
	}

	.stages {
		margin: 56px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
	}

	.stage {
		background: var(--color-navy);
		color: var(--color-white);
		--focus: var(--color-white);
		transition: background-color 300ms ease;
	}

	.stage {
		background: var(--color-navy-2);
	}

	.stage--alt {
		background: #12355a;
	}

	.stage[data-open='true'] {
		background: var(--color-navy);
	}

	.stage__heading {
		margin: 0;
		font: inherit;
	}

	.stage__button {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		min-height: 64px;
		padding: 0 20px;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: var(--step-lead);
		font-weight: 700;
		text-align: left;
		cursor: pointer;
		touch-action: manipulation;
	}

	.stage__button::after {
		content: '+';
		font-weight: 400;
		transition: transform 200ms var(--ease-out);
	}

	.stage__button[aria-expanded='true']::after {
		transform: rotate(45deg);
	}

	.stage__panel {
		padding: 0 20px 28px;
	}

	.stage__panel p {
		max-width: 36ch;
	}

	/* No JavaScript: every stage stays open. With JavaScript, closed stages hide their text. */
	:global(.js-motion) .stage[data-open='false'] .stage__panel {
		display: none;
	}

	@media (min-width: 1024px) {
		.process__title {
			grid-column: 1 / span 5;
		}

		.process__lede {
			grid-column: 7 / span 5;
			align-self: end;
		}

		.stages.is-enhanced {
			flex-direction: row;
			height: 520px;
			margin-top: 64px;
		}

		.is-enhanced .stage {
			position: relative;
			flex: 0 0 calc(42% / 4);
			min-width: 0;
			overflow: hidden;
			transition: flex-basis 450ms var(--ease-out);
		}

		.is-enhanced .stage[data-open='true'] {
			flex-basis: 58%;
		}

		.is-enhanced .stage__button {
			position: absolute;
			inset: 0;
			display: block;
			min-height: 0;
			padding: 0;
		}

		.is-enhanced .stage__button::after {
			content: none;
		}

		.is-enhanced .stage__name {
			position: absolute;
			left: 20px;
			bottom: 24px;
			writing-mode: vertical-rl;
			transform: rotate(180deg);
			white-space: nowrap;
		}

		.is-enhanced .stage[data-open='true'] .stage__name {
			top: 32px;
			bottom: auto;
			left: 32px;
			writing-mode: horizontal-tb;
			transform: none;
			font-size: var(--step-head);
			font-weight: 700;
			letter-spacing: -0.02em;
			line-height: 1.04;
		}

		.is-enhanced .stage__panel {
			position: absolute;
			left: 32px;
			right: 32px;
			bottom: 32px;
			padding: 0;
			pointer-events: none;
		}

		:global(.js-motion) .stage[data-open='false'] .stage__panel {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stage {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-stages]').forEach((list) => {
		list.classList.add('is-enhanced');
		const stages = Array.from(list.querySelectorAll<HTMLElement>('.stage'));
		stages.forEach((stage) => {
			const button = stage.querySelector<HTMLButtonElement>('.stage__button');
			button?.addEventListener('click', () => {
				const wasOpen = stage.dataset.open === 'true';
				const desktop = window.matchMedia('(min-width: 1024px)').matches;
				if (desktop && wasOpen) return; /* one stage always open on desktop */
				stages.forEach((other) => {
					other.dataset.open = 'false';
					other.querySelector('.stage__button')?.setAttribute('aria-expanded', 'false');
				});
				if (!wasOpen) {
					stage.dataset.open = 'true';
					button.setAttribute('aria-expanded', 'true');
				}
			});
		});
	});
</script>
