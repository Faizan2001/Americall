---
import { processStages } from '../data/site';
---
<section class="chapter ground-white process" id="how-it-works" aria-labelledby="process-title">
	<div class="wrap process__layout">
		<div class="process__intro">
			<h2 class="t-head" id="process-title">How it runs</h2>
			<p class="t-body">Your account manager walks you through the campaign from setup to hand-off.</p>
		</div>
		<ol class="stages">
			{processStages.map((stage) => (
				<li class="stage">
					<h3 class="t-lead">{stage.name}</h3>
					<p class="t-body">{stage.text}</p>
				</li>
			))}
		</ol>
	</div>
</section>
<style>
	.process__layout { display: grid; gap: 36px; }
	.process__intro { display: grid; gap: 20px; align-content: start; }
	.process__intro p { max-width: 30ch; }
	.stages { margin: 0; padding-left: 28px; list-style: decimal; }
	.stage { padding: 0 0 24px 12px; }
	.stage + .stage { padding-top: 24px; border-top: 1px solid var(--color-navy); }
	.stage:last-child { padding-bottom: 0; }
	.stage::marker { font-weight: 700; }
	.stage h3 { font-weight: 700; margin-bottom: 10px; }
	.stage p { max-width: 58ch; }
	@media (min-width: 1024px) {
		.process__layout { grid-template-columns: 1fr 1.5fr; gap: 64px; }
	}
</style>
