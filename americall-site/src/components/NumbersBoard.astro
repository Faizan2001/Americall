---
import { stats } from '../data/site';
---

<section class="chapter ground-navy numbers" data-tone="dark" aria-labelledby="numbers-title">
	<div class="wrap numbers__inner">
		<h2 class="t-head" id="numbers-title">Numbers so far</h2>
		{/* A ledger, not tiles: each figure sits on a hairline with its label underneath. */}
		<dl class="ledger">
			{
				stats.map((stat) => (
					<div class="ledger__item">
						<dt class="ledger__label t-body">{stat.label}</dt>
						<dd class="ledger__value">{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.numbers__inner {
		display: grid;
		gap: 32px;
	}

	.ledger {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px var(--gap);
		margin: 0;
	}

	/* Label follows the figure on screen; in the markup it comes first, so it is read before the number. */
	.ledger__item {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 8px;
		padding-top: 16px;
		border-top: 1px solid color-mix(in srgb, var(--color-ink-2-dark) 45%, transparent);
		container-type: inline-size;
	}

	.ledger__label {
		color: var(--ink-2);
	}

	/* "10,000+" is about 3.8em wide in Chivo, so 24cqi always fits the column. */
	.ledger__value {
		margin: 0;
		font-size: min(var(--step-head), 24cqi);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 600px) {
		.ledger {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.numbers__inner {
			grid-template-columns: 1fr 1.5fr;
			gap: 64px;
		}

		.ledger {
			row-gap: 40px;
		}
	}
</style>
