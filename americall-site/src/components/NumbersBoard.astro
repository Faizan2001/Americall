---
import { stats } from '../data/site';
---

<section class="chapter ground-navy numbers" data-tone="dark" aria-labelledby="numbers-title">
	<div class="wrap">
		<ul class="board" role="list">
			<li class="tile tile--head" data-reveal>
				<h2 class="t-head" id="numbers-title">Numbers so far</h2>
			</li>
			{
				stats.map((stat, i) => (
					<li class="tile" data-reveal style={`--reveal-i:${(i % 3) + 1}`}>
						<p class="tile__value t-head">{stat.value}</p>
						<p class="tile__label t-body">{stat.label}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.board {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tile {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-height: 150px;
		padding: 20px;
		border-radius: var(--radius);
		background: var(--color-navy-2);
		container-type: inline-size;
	}

	.tile--head {
		grid-column: 1 / -1;
		min-height: 0;
		justify-content: flex-end;
		padding: 0 0 16px;
		background: transparent;
	}

	/* Widest value ("10,000+") measures 3.77em in Chivo 900, so 24cqi always fits the tile. */
	.tile__value {
		font-size: min(var(--step-head), 24cqi);
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 768px) {
		.board {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 8px;
		}

		.tile {
			min-height: 150px;
			padding: 24px;
		}

		.tile--head {
			grid-column: span 2;
		}
	}

	@media (min-width: 1280px) {
		.tile {
			min-height: 0;
			aspect-ratio: 3 / 2;
		}

		.tile--head {
			aspect-ratio: auto;
		}
	}
</style>
