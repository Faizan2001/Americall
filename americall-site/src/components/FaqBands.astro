---
import { faqs, slugify } from '../data/site';

interface Props {
	indexes?: number[];
	headingLevel?: 'h1' | 'h2';
	showAllLink?: boolean;
}

const { indexes, headingLevel = 'h2', showAllLink = false } = Astro.props;
const items = indexes ? indexes.map((i) => faqs[i]).filter(Boolean) : faqs;
const Heading = headingLevel;
const QuestionTag = headingLevel === 'h1' ? 'h2' : 'h3';
---

<section class="faq" aria-labelledby="faq-title">
	<div class:list={['chapter', 'ground-soft', 'faq__head', headingLevel === 'h1' && 'faq__head--first']} data-tone="light">
		<div class="wrap">
			<Heading class="t-head" id="faq-title" data-reveal>Questions, answered</Heading>
		</div>
	</div>
	{
		items.map((item, i) => (
			<div class:list={['chapter', i % 2 === 0 ? 'ground-white' : 'ground-soft', 'band']} data-tone="light" id={slugify(item.question)}>
				<div class="wrap grid-12 band__inner">
					<QuestionTag class="band__q t-lead" data-reveal>
						{item.question}
					</QuestionTag>
					<p class="band__a t-body" data-reveal style="--reveal-i:1">
						{item.answer}
					</p>
				</div>
			</div>
		))
	}
	{
		showAllLink && (
			<div class:list={['chapter', items.length % 2 === 0 ? 'ground-white' : 'ground-soft', 'band', 'band--link']} data-tone="light">
				<div class="wrap">
					<a class="link-arrow" href="/faq/">
						All questions <span class="arrow" aria-hidden="true">&rarr;</span>
					</a>
				</div>
			</div>
		)
	}
</section>

<style>
	.faq__head {
		min-height: 30svh;
		display: flex;
		align-items: flex-end;
		padding-bottom: 40px;
	}

	.faq__head--first {
		padding-top: var(--pill-clearance);
	}

	.faq__head .wrap {
		width: 100%;
	}

	.band {
		padding-block: 32px;
	}

	.band__inner {
		row-gap: 10px;
	}

	.band__q {
		grid-column: 1 / -1;
		font-weight: 700;
	}

	.band__a {
		grid-column: 1 / -1;
		max-width: 62ch;
	}

	.band--link {
		padding-block: 20px 40px;
	}

	@media (min-width: 768px) {
		.faq__head {
			min-height: 40svh;
			padding-bottom: 56px;
		}

		.band {
			padding-block: 56px;
		}

		.band__q {
			grid-column: 1 / span 5;
		}

		.band__a {
			grid-column: 7 / span 6;
		}
	}
</style>
