---
import { faqOrder, faqs, slugify } from '../data/site';

interface Props {
	indexes?: number[];
	headingLevel?: 'h1' | 'h2';
	showAllLink?: boolean;
	openFirst?: boolean;
}

const { indexes = faqOrder, headingLevel = 'h2', showAllLink = false, openFirst = true } = Astro.props;
const items = indexes.map((i) => faqs[i]).filter(Boolean);
const Heading = headingLevel;
const QuestionTag = headingLevel === 'h1' ? 'h2' : 'h3';
---

<section class="faq" aria-labelledby="faq-title">
	<div class:list={['chapter', 'ground-soft', 'faq__head', headingLevel === 'h1' && 'faq__head--first']} data-tone="light">
		<div class="wrap">
			<Heading class="t-head" id="faq-title" data-reveal>Questions, answered</Heading>
		</div>
	</div>

	<div class="chapter ground-white faq__body" data-tone="light">
		<div class="wrap">
			<div class="faq__list" data-faq>
				{
					items.map((item, i) => (
						<details class="qa" id={slugify(item.question)} open={openFirst && i === 0}>
							<summary class="qa__summary">
								<QuestionTag class="qa__q t-lead">{item.question}</QuestionTag>
								<span class="qa__icon" aria-hidden="true" />
							</summary>
							<div class="qa__a">
								<p class="t-body">{item.answer}</p>
							</div>
						</details>
					))
				}
			</div>
			{
				showAllLink && (
					<a class="link-arrow faq__all" href="/faq/">
						All questions <span class="arrow" aria-hidden="true">&rarr;</span>
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.faq__head {
		min-height: 22svh;
		display: flex;
		align-items: flex-end;
		padding-bottom: 32px;
	}

	.faq__head--first {
		padding-top: var(--pill-clearance);
	}

	.faq__head .wrap {
		width: 100%;
	}

	.faq__body {
		padding-top: 40px;
	}

	.faq__list {
		display: grid;
		gap: 8px;
		max-width: 920px;
	}

	.qa {
		border-radius: var(--radius);
		background: var(--color-soft);
		transition: background-color 200ms ease;
	}

	.qa[open] {
		background: #edf1f6;
	}

	.qa__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		min-height: 64px;
		padding: 16px 20px;
		border-radius: var(--radius);
		cursor: pointer;
		list-style: none;
		touch-action: manipulation;
		-webkit-user-select: none;
		user-select: none;
	}

	.qa__summary::-webkit-details-marker {
		display: none;
	}

	.qa__q {
		margin: 0;
		font-size: var(--step-lead);
		font-weight: 700;
		line-height: 1.3;
	}

	/* Plus that turns into a minus when open. */
	.qa__icon {
		position: relative;
		flex: 0 0 auto;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--color-white);
	}

	.qa__icon::before,
	.qa__icon::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 14px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-navy);
		transform: translate(-50%, -50%);
		transition: transform 250ms var(--ease-out);
	}

	.qa__icon::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.qa[open] .qa__icon::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}

	.qa__a {
		padding: 0 20px 22px;
	}

	.qa__a p {
		max-width: 62ch;
	}

	/* Smooth open/close where the browser supports animating details (progressive enhancement). */
	@supports selector(::details-content) {
		.qa {
			interpolate-size: allow-keywords;
		}

		.qa::details-content {
			block-size: 0;
			overflow: hidden;
			transition:
				block-size 280ms var(--ease-out),
				content-visibility 280ms allow-discrete;
		}

		.qa[open]::details-content {
			block-size: auto;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.qa:not([open]):hover {
			background: #edf1f6;
		}
	}

	.faq__all {
		margin-top: 24px;
	}

	@media (min-width: 768px) {
		.faq__head {
			min-height: 30svh;
			padding-bottom: 40px;
		}

		.faq__body {
			padding-top: 56px;
		}

		.qa__summary {
			min-height: 76px;
			padding: 20px 28px;
		}

		.qa__a {
			padding: 0 28px 28px;
		}
	}

	/* Line the list up with the right-hand column the service and process sections use, instead of leaving half the row empty.
	   Only from 1440px: narrower, the offset squeezes each question onto two lines. */
	@media (min-width: 1440px) {
		.faq__list {
			max-width: none;
		}

		.faq__list,
		.faq__all {
			margin-left: calc((100% - 64px) * 0.4 + 64px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.qa::details-content {
			transition: none;
		}
	}
</style>

<script>
	/* Open the question a link points to (for example /faq/#what-pricing-plans-does-americall-offer). */
	const openFromHash = () => {
		const id = decodeURIComponent(window.location.hash.slice(1));
		if (!id) return;
		const target = document.getElementById(id);
		if (target instanceof HTMLDetailsElement) {
			target.open = true;
			target.scrollIntoView({ block: 'start', behavior: 'instant' });
		}
	};
	openFromHash();
	window.addEventListener('hashchange', openFromHash);
</script>
