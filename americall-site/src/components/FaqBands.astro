---
import { faqOrder, faqs, slugify } from '../data/site';

interface Props {
	indexes?: number[];
	headingLevel?: 'h1' | 'h2';
	showAllLink?: boolean;
	openFirst?: boolean;
}

const { indexes = faqOrder, headingLevel = 'h2', showAllLink = false, openFirst = true } = Astro.props;
const items = indexes.map((i) => faqs[i]).filter(Boolean);
const Heading = headingLevel;
const QuestionTag = headingLevel === 'h1' ? 'h2' : 'h3';
---

<section
	class:list={['chapter', 'ground-white', 'faq', headingLevel === 'h1' && 'faq--first']}
	data-tone="light"
	aria-labelledby="faq-title"
>
	<div class="wrap faq__inner">
		<div class="faq__intro">
			<Heading class="t-head" id="faq-title">Questions, answered</Heading>
			{showAllLink && <a class="text-link" href="/faq/">All questions</a>}
		</div>
		<div class="faq__list" data-faq>
			{
				items.map((item, i) => (
					<details class="qa" id={slugify(item.question)} open={openFirst && i === 0}>
						<summary class="qa__summary">
							<QuestionTag class="qa__q t-lead">{item.question}</QuestionTag>
							<span class="qa__icon" aria-hidden="true" />
						</summary>
						<div class="qa__a">
							<p class="t-body">{item.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	/* One band: heading beside a hairline list, instead of a title band over grey boxes. */
	.faq {
		--rule: color-mix(in srgb, var(--color-navy) 18%, transparent);
	}

	.faq--first {
		padding-top: var(--pill-clearance);
	}

	.faq__inner {
		display: grid;
		gap: 32px;
	}

	.faq__intro {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: 12px;
	}

	.faq__list {
		border-top: 1px solid var(--rule);
	}

	.qa {
		border-bottom: 1px solid var(--rule);
		/* Deep links (/faq/#question) land below the fixed pill. */
		scroll-margin-top: var(--pill-clearance);
	}

	.qa__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		min-height: 64px;
		padding-block: 20px;
		cursor: pointer;
		list-style: none;
		touch-action: manipulation;
		-webkit-user-select: none;
		user-select: none;
	}

	.qa__summary::-webkit-details-marker {
		display: none;
	}

	.qa__q {
		margin: 0;
		font-size: var(--step-lead);
		font-weight: 700;
		line-height: 1.3;
	}

	/* Plus that turns into a minus when open. */
	.qa__icon {
		position: relative;
		flex: 0 0 auto;
		width: 36px;
		height: 36px;
		border: 1px solid #798594;
		border-radius: 50%;
		transition:
			background-color 160ms ease,
			border-color 160ms ease;
	}

	.qa__icon::before,
	.qa__icon::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 14px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-navy);
		transform: translate(-50%, -50%);
		transition:
			transform 250ms var(--ease-out),
			background-color 160ms ease;
	}

	.qa__icon::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.qa[open] .qa__icon::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}

	.qa__a {
		padding-bottom: 24px;
	}

	.qa__a p {
		max-width: 62ch;
	}

	/* Smooth open/close where the browser supports animating details (progressive enhancement). */
	@supports selector(::details-content) {
		.qa {
			interpolate-size: allow-keywords;
		}

		.qa::details-content {
			block-size: 0;
			overflow: hidden;
			transition:
				block-size 280ms var(--ease-out),
				content-visibility 280ms allow-discrete;
		}

		.qa[open]::details-content {
			block-size: auto;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.qa__summary:hover .qa__icon {
			border-color: var(--color-navy);
			background: var(--color-navy);
		}

		.qa__summary:hover .qa__icon::before,
		.qa__summary:hover .qa__icon::after {
			background: var(--color-white);
		}
	}

	@media (min-width: 768px) {
		.qa__summary {
			min-height: 76px;
			padding-block: 24px;
		}

		.qa__a {
			padding-bottom: 28px;
		}
	}

	/* Side by side only where the list keeps room for one-line questions. */
	@media (min-width: 1280px) {
		.faq__inner {
			grid-template-columns: 1fr 2fr;
			gap: 64px;
		}

		.faq__intro {
			position: sticky;
			top: var(--pill-clearance);
			align-self: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.qa::details-content {
			transition: none;
		}
	}
</style>

<script>
	/* Open the question a link points to (for example /faq/#what-pricing-plans-does-americall-offer). */
	const openFromHash = () => {
		const id = decodeURIComponent(window.location.hash.slice(1));
		if (!id) return;
		const target = document.getElementById(id);
		if (target instanceof HTMLDetailsElement) {
			target.open = true;
			target.scrollIntoView({ block: 'start', behavior: 'instant' });
		}
	};
	openFromHash();
	window.addEventListener('hashchange', openFromHash);
</script>
